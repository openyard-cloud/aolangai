{
  "name": "aolangai-site",
  // account_id is left out on purpose: whoever deploys sets it, for example with the CLOUDFLARE_ACCOUNT_ID
  // environment variable. Build first with npm run build:site; site/demo/ is not in git.
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    // the default, set explicitly: /privacy serves privacy.html, and /privacy.html redirects to /privacy
    "html_handling": "auto-trailing-slash"
  },
  // every pull request gets a preview URL from Cloudflare Worker Previews
  "preview_urls": true,
  "previews": {},
  "routes": [{ "pattern": "aolangai.openyard.cloud", "custom_domain": true }]
}
